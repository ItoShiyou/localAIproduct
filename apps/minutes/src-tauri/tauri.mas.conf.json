{
  "bundle": {
    "targets": [
      "app"
    ],
    "macOS": {
      "entitlements": "Entitlements.mas.plist",
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.mas.plist",
      "bundleVersion": "1"
    },
    "resources": [
      "resources/THIRD_PARTY_NOTICES.txt",
      "resources/models/ggml-large-v3-turbo-q5_0.bin",
      "resources/models/ggml-small-q5_1.bin",
      "resources/models/voxceleb_resnet34_LM.onnx",
      "resources/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf",
      "resources/onnxruntime/*"
    ],
    "icon": [
      "icons/mas/icon.png",
      "icons/mas/icon.icns"
    ],
    "copyright": "© 2026 尾薗圭亮",
    "category": "Productivity"
  },
  "build": {
    "beforeBuildCommand": {
      "script": "node tools/build_mas_ui.mjs",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "minutes",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": true
      }
    ]
  }
}
