{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minutes",
  "version": "0.1.0",
  "identifier": "dev.localaiproduct.minutes",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "devUrl": "http://127.0.0.1:5175",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "議事録(仮称)",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "resources/THIRD_PARTY_NOTICES.txt",
      "resources/models/ggml-large-v3-turbo-q5_0.bin",
      "resources/models/voxceleb_resnet34_LM.onnx",
      "resources/onnxruntime/*"
    ],
    "copyright": "© 2026 (権利者名は販売前に記入)",
    "shortDescription": "録音を端末の中で文字にする議事録アプリ",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}