{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "receipt-db",
  "version": "0.1.0",
  "identifier": "dev.localaiproduct.receiptdb",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "領収書DB(仮称)", "width": 1200, "height": 800, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
